{
  "name": "iobroker.vis-jsontemplate",
  "version": "4.6.2",
  "description": "vis-jsontemplate",
  "author": {
    "name": "oweitman",
    "email": "oweitman@gmx.de"
  },
  "homepage": "https://github.com/oweitman/ioBroker.vis-jsontemplate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oweitman/ioBroker.vis-jsontemplate.git"
  },
  "keywords": [
    "ioBroker",
    "visualization",
    "widgets",
    "JSON template",
    "Smart Home"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/vis-2-widgets-react-dev": "^4.0.4",
    "@iobroker/vis-2-widgets-testing": "^2.0.0",
    "@types/node": "^25.9.9"
  },
  "main": "widgets/vis2jsontemplate/customWidgets.js",
  "files": [
    "admin/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test:package": "mocha test/package --exit",
    "test:widgets": "mocha ./test/*.test.js",
    "test:integration": "mocha test/widgets.test.js --exit",
    "testbakcip": "npm run test:package && npm run test:widgets",
    "test": "npm run test:package ",
    "prepublishOnly": "npm run build-vis1widgets && npm run build-vis2widgets",
    "lint": "npm run lint-adapter && npm run lint-vis1widgets && npm run lint-vis2widgets",
    "lint-adapter": "eslint -c eslint.config.mjs .",
    "lint-vis1widgets": "cd widgets/ && npm run lint && cd ../..",
    "lint-vis2widgets": "cd src-widgets/ && npm run lint && cd ../..",
    "build": "npm run build-vis1widgets && npm run build-vis2widgets",
    "build-vis2widgets": "node tasks --javascript-vite",
    "build-vis1widgets": "cd widgets/vis-jsontemplate && npm run build && cd ../..",
    "dev:upload": "dev-server upload",
    "dev:run": "dev-server run",
    "dev:watch": "dev-server watch --noStart",
    "dev:watchvis2widgets": "npm run start --prefix src-widgets",
    "dev:watchvis1widgets": "npm run watch --prefix widgets",
    "release": "release-script --all",
    "update-packages": "ncu --upgrade && cd src-widgets && ncu --upgrade && cd ..",
    "npm": "npm run npm:main && npm run npm:vis1widgets && npm run npm:vis2widgets",
    "npm:main": "npm i -f",
    "npm:vis2widgets": "cd src-widgets && npm i -f && cd ..",
    "npm:vis1widgets": "cd widgets && npm i && cd ..",
    "repochecker": "npx github:oweitman/ioBroker.repochecker https://github.com/oweitman/ioBroker.vis-jsontemplate --noinfo --local --env=../iobroker.env",
    "translate": "translate-adapter",
    "translate-widgets-vis2": "node ./bin/translate.js --source src-widgets/src/i18n/",
    "translate-widgets-vis1": "node ./bin/translate.js --source widgets/vis-jsontemplate/myi18n/en.json --format single"
  },
  "bugs": {
    "url": "https://github.com/oweitman/ioBroker.vis-jsontemplate/issues"
  },
  "readmeFilename": "README.md"
}
